# Copy to .env and fill in what you have. Everything is optional:
# with no keys at all the pipeline still runs on Wikipedia + GDELT.

# Wikimedia's user-agent policy asks for a contact address. No signup needed —
# just be reachable. Strongly recommended before running the ingest.
CONTACT_EMAIL=you@example.com

# --- Optional: Google Trends via SerpAPI (paid) -----------------------------
# https://serpapi.com/google-trends-api
# Upgrades the search signal from Wikipedia pageviews to real Trends data.
# SERPAPI_KEY=

# --- Optional: Google Trends by scraping (free, no key, ToS grey) -----------
# Uses Trends' own unofficial endpoints. Free and it works, but it's against
# Google's ToS and it rate-limits hard (429) past a trickle — expect to need
# proxies at any real volume. Falls back to Wikipedia pageviews when blocked.
# Only used when SERPAPI_KEY is unset.
# GOOGLE_TRENDS_SCRAPE=true

# Fixed reference term co-requested with every batch so values are comparable
# across runs. Should be high-volume and unrelated to fashion. See README.
# GOOGLE_TRENDS_ANCHOR=weather

# --- Optional: eBay commerce signal (free developer account) ----------------
# https://developer.ebay.com/ — create an app, use the Production keyset.
# Commerce history accumulates one reading per run, so this signal becomes
# usable after ~30 days of scheduled ingests.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
